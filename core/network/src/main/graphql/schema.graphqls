  autoResults: [PredictionResult!]!

  createdAt: DateTime!

  finalResults: [PredictionResult!]!

  id: ID!

  optionSource: PredictionOptionSource!

  options: [PredictionOption!]!

  points: Int!

  prediction: Prediction!

  prompt: String!

  settings: JSON

  sortOrder: Int!
}

input PredictionQuestionCreateInput {
  optionSource: PredictionOptionSource!

  options: [String!]! = []

  points: Int!

  predictionId: ID!

  prompt: String!

  settings: JSON

  sortOrder: Int
}

input PredictionQuestionEditInput {
  id: ID

  optionSource: PredictionOptionSource!

  options: [String!]

  points: Int!

  prompt: String!

  settings: JSON

  sortOrder: Int!
}

input PredictionQuestionsEditInput {
  predictionId: ID!

  questions: [PredictionQuestionEditInput!]!
}

type PredictionResult {
  id: ID!

  isFinalResult: Boolean!

  resultValue: ID
}

input PredictionResultInput {
  heroId: ID

  optionId: ID

  playerId: ID

  teamId: ID
}

input PredictionResultsSetInput {
  isFinalResult: Boolean!

  questionId: ID!

  results: [PredictionResultInput!]!
}

enum PredictionState {
  DRAFT

  OPEN

  LOCKED

  SETTLED
}

enum Provider {
  INTERNAL

  STEAM

  DISCORD

  TWITCH

  EPIC_GAMES
}

type ProviderLink {
  canEdit: Boolean!

  displayName: String

  externalId: String!

  id: Int!

  linkedAt: DateTime

  loginEnabled: Boolean

  provider: Provider!

  public: Boolean!

  username: String
}

input ProviderUpdateInput {
  loginEnabled: Boolean

  public: Boolean
}

type Query {
  application(id: ID!): Application

  applicationsPaginated(limit: Int, offset: Int): PaginatedApplications

  backend: Backend!

  comment(id: ID!): Comment

  communityChallenge(id: Int!): CommunityChallenge

  connectionInfo: ConnectionInfo!

  currentAuth: Authorization

  currentUser: User

  eternalCategories: [EternalCategory!]!

  eternalCategory(by: EternalCategoryKey!): EternalCategory

  event(by: EventKey!): Event

  events(filters: EventFiltersInput): [Event!]!

  group(id: ID!): Group

  groups: [Group!]

  guide(by: GuideKey!): Guide

  guidesPaginated(filter: GuideFilterInput, order: GuideOrderInput, limit: Int, offset: Int): PaginatedGuides!

  hero(by: HeroKey!): Hero

  heroes: [Hero!]!

  item(by: ItemKey!): Item

  items: [Item!]!

  leaderboardPaginated(ratingId: ID!, ratingType: LeaderboardRatingType, limit: Int, offset: Int, filter: LeaderboardFilterInput): PaginatedLeaderboard!

  match(by: MatchKey!): Match

  matchSpoilerBlocks(includeRejected: Boolean): [MatchSpoilerBlock!]!

  perk(by: PerkKey!): Perk

  perks: [Perk!]!

  player(by: PlayerKey!): Player

  players(by: [PlayerKey!]!): [Player]!

  playersPaginated(filter: PlayerFilterInput!, limit: Int, offset: Int): PaginatedPlayers!

  prediction(id: ID!): Prediction

  rating(by: RatingKey!): Rating

  ratingStatistic(ratingId: ID!, granularity: RatingStatisticGranularity!, filter: RatingStatisticFilterInput): RatingStatisticResult

  ratings: [Rating!]!

  team(id: ID!): Team

  teams: [Team!]!

  user(by: UserKey!): User

  version(by: VersionKey): Version

  versions: [Version!]!
}

type Rank {
  abbreviation: String!

  divisionIdx: Int!

  icon: String!

  id: ID!

  name: String!

  ratingMax: Float!

  ratingMin: Float!

  tierIdx: Int!

  tierName: String!
}

type Rating {
