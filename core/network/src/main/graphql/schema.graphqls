"""
The `Boolean` scalar type represents `true` or `false`.
"""
scalar Boolean

type Bracket {
  edges: [BracketEdge!]!

  event: Event!

  id: ID!

  kind: BracketKind!

  nodes: [BracketNode!]!

  order: Int!

  title: String!
}

input BracketCreateInput {
  edges: [BracketEdgeCreateInput!]!

  eventId: ID!

  kind: BracketKind!

  nodes: [BracketNodeCreateInput!]!

  order: Int!

  title: String!
}

type BracketEdge {
  bracket: Bracket!

  conditionKind: BracketEdgeConditionKind!

  id: ID!

  priority: Int!

  sourceNode: BracketNode!

  sourceRank: Int!

  targetEntry: BracketNodeEntry!
}

enum BracketEdgeConditionKind {
  ALWAYS

  IF_NEEDED

  IF_NODE_PLAYED
}

input BracketEdgeCreateInput {
  conditionKind: BracketEdgeConditionKind!

  priority: Int!

  sourceNode: BracketEdgeSourceNodeInput!

  sourceRank: Int!

  targetEntryTempId: Int!
}

input BracketEdgeSourceNodeInput @oneOf {
  nodeId: ID

  tempNodeId: Int
}

enum BracketKind {
  SINGLE_ELIMINATION

  DOUBLE_ELIMINATION

  ROUND_ROBIN

  SWISS
}

type BracketNode {
  autoProtectEnabled: Boolean!

  bracket: Bracket

  edges: [BracketEdge!]!

  entries: [BracketNodeEntry!]!

  id: ID!

  matchCount: Int

  matches: [Match!]!

  nodeType: BracketNodeType!

  roundNumber: Int

  status: BracketNodeStatus!
}

input BracketNodeAutoProtectInput {
  enabled: Boolean!

  nodeId: ID!
}

input BracketNodeCreateInput {
  autoProtectEnabled: Boolean

  entries: [BracketNodeEntryCreateInput!]!

  matchCount: Int

  nodeType: BracketNodeType!

  roundNumber: Int

  status: BracketNodeStatus!

  tempId: Int!
}

type BracketNodeEntry {
  edges: [BracketEdge!]!

  eventEntry: EventEntry

  id: ID!

  node: BracketNode!

  preLosses: Int

  score: Int
}

input BracketNodeEntryCreateInput {
  eventEntryId: ID

  preLosses: Int

  score: Int

  tempId: Int!
}

input BracketNodeMatchAssignInput {
  liftSpoilerBlock: Boolean

  matchId: ID!

  nodeId: ID!
}

input BracketNodeMatchUnassignInput {
  matchId: ID!

  nodeId: ID!
}

enum BracketNodeStatus {
  PENDING

  READY

  IN_PROGRESS

  COMPLETED

  CANCELLED

  SKIPPED
}

enum BracketNodeType {
  DEFAULT

  SEED_POOL

  RESULT
}

input BracketOrderInput {
  id: ID!

  order: Int!
}

input BracketOrdersInput {
  brackets: [BracketOrderInput!]!
}

input BracketScoreInput {
  entryId: ID!

  score: Int!
}

