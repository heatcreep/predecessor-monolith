  avgDiffFavourLose: Float

  avgDiffFavourWin: Float

  avgSpread: Float

  avgSpreadLose: Float

  avgSpreadTeam: Float

  avgSpreadWin: Float

  bucketTs: DateTime!

  corrDiffMagnitudeVsCorrect: Float

  count0Diff: Int!

  countDiff: Int!

  countDiffFavourLose: Int!

  countDiffFavourWin: Int!

  countMatch: Int!

  countSpread: Int!

  countSpreadLose: Int!

  countSpreadTeam: Int!

  countSpreadWin: Int!

  outlierCountDiff: Int!

  outlierCountDiffFavourLose: Int!

  outlierCountDiffFavourWin: Int!

  outlierCountSpread: Int!

  outlierCountSpreadLose: Int!

  outlierCountSpreadTeam: Int!

  outlierCountSpreadWin: Int!

  quantilesDiff: [Float!]!

  quantilesDiffFavourLose: [Float!]!

  quantilesDiffFavourWin: [Float!]!

  quantilesSpread: [Float!]!

  quantilesSpreadLose: [Float!]!

  quantilesSpreadTeam: [Float!]!

  quantilesSpreadWin: [Float!]!

  stddevDiff: Float

  stddevDiffFavourLose: Float

  stddevDiffFavourWin: Float

  stddevSpread: Float

  stddevSpreadLose: Float

  stddevSpreadTeam: Float

  stddevSpreadWin: Float

  totalDiff: Float

  totalDiffFavourLose: Float

  totalDiffFavourWin: Float

  totalSpread: Float

  totalSpreadLose: Float

  totalSpreadTeam: Float

  totalSpreadWin: Float
}

type RatingStatisticFilter {
  gameModes: [GameMode!]

  placementCounts: [Int!]

  rankIds: [ID!]

  regions: [Region!]

  timeframe: TimeFrame
}

input RatingStatisticFilterInput {
